{% doc %}
  Subcategory Link

  Renders a single subcategory navigation link for collection pages.
  Used inside the main-collection section to display horizontal category links.

  @example
  {% content_for 'block', type: '_subcategory-link', id: 'link-underwear' %}
{% enddoc %}

{% liquid
  assign link_url = block.settings.url | default: '#'
  assign link_label = block.settings.label
%}

{% if link_label != blank %}
  <a
    href="{{ link_url }}"
    class="collection-subcategory-link"
    {{ block.shopify_attributes }}
  >
    {{- link_label | escape -}}
  </a>
{% endif %}

{% stylesheet %}
  .collection-subcategory-link {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 12px;
    line-height: 19px;
    text-decoration: underline;
    text-transform: capitalize;
    color: var(--color-foreground);
    white-space: nowrap;
    text-underline-offset: 3px;
    transition: opacity var(--animation-speed) ease;

    &:hover {
      opacity: 0.7;
    }

    @media screen and (min-width: 750px) {
      font-size: 16px;
      line-height: 23px;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.subcategory_link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.link_label"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:settings.link_url"
    }
  ],
  "presets": [
    {
      "name": "t:names.subcategory_link"
    }
  ]
}
{% endschema %}
