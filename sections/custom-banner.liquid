<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="custom-banner section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="custom-banner__content">
    {% if section.settings.heading != blank %}
      <h2 class="custom-banner__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="custom-banner__description">{{ section.settings.description | escape }}</p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% endif %}
        class="custom-banner__button"
      >
        {{ section.settings.button_text | escape }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .custom-banner__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .custom-banner__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 500;
    font-size: 56px;
    line-height: 60px;
    letter-spacing: 0.28px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .custom-banner__description {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 18px;
    line-height: 23px;
    color: var(--color-foreground);
    margin: 0;
    max-width: 456px;
  }

  .custom-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 500;
    font-size: 18px;
    line-height: 23px;
    color: var(--color-foreground);
    background: transparent;
    border: 2px solid var(--color-foreground);
    min-width: 271px;
    height: 55px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .custom-banner__button:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .custom-banner__heading {
      font-size: 40px;
      line-height: 44px;
      letter-spacing: 0.2px;
    }

    .custom-banner__description {
      font-size: 14px;
      line-height: 19px;
      max-width: 304px;
    }

    .custom-banner__button {
      font-size: 14px;
      line-height: 19px;
      min-width: 247px;
      height: 43px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_banner",
  "settings": [
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Find your style"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:names.description",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:settings.button_text",
      "default": "START QUIZ"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-7"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_banner",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
