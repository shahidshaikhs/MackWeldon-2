<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    review-carousel
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --columns-gap: {{ section.settings.columns_gap }}px;
  "
>
  <slideshow-component class="review-carousel__slideshow" infinite>
    <div class="review-carousel__header">
      <h2 class="review-carousel__heading">{{ section.settings.heading | escape }}</h2>
      {%- render 'slideshow-arrows', class: 'review-carousel__arrows--mobile', icon_style: 'chevron', icon_shape: 'none' -%}
    </div>
    <slideshow-container ref="slideshowContainer" class="review-carousel__container">
      {%- render 'slideshow-arrows', class: 'review-carousel__arrows--desktop', icon_style: 'chevron', icon_shape: 'none' -%}
      <slideshow-slides ref="scroller" tabindex="-1" class="review-carousel__slides">
        {%- for block in section.blocks -%}
          <slideshow-slide {{ block.shopify_attributes }} class="review-carousel__slide">
            <div class="review-card">
              {%- if block.settings.product_image != blank -%}
                <div class="review-card__image">
                  {{
                    block.settings.product_image
                    | image_url: width: 324
                    | image_tag:
                      widths: '132,162,264,324',
                      sizes: '(min-width: 750px) 162px, 132px',
                      loading: 'lazy',
                      alt: block.settings.product_name
                  }}
                </div>
              {%- endif -%}
              <div class="review-card__content">
                <div class="review-card__meta">
                  {%- render 'star-rating',
                    rating: block.settings.star_rating,
                    count: block.settings.review_count,
                    star_color: section.settings.star_color,
                    empty_color: section.settings.empty_star_color
                  -%}
                  <p class="review-card__product-name">{{ block.settings.product_name | escape }}</p>
                </div>
                <div class="review-card__quote">
                  <p class="review-card__text">{{ block.settings.review_text }}</p>
                  <p class="review-card__reviewer">{{ block.settings.reviewer_name | escape }}</p>
                </div>
              </div>
            </div>
          </slideshow-slide>
        {%- endfor -%}
      </slideshow-slides>
    </slideshow-container>
  </slideshow-component>
</div>

{% stylesheet %}
  .review-carousel {
    --columns-gap: 16px;
  }

  .review-carousel__slideshow {
    display: block;
    width: 100%;
  }

  .review-carousel__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: 24px;
  }

  .review-carousel__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 24px;
    line-height: 28px;
    letter-spacing: 0.12px;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .review-carousel__heading {
      font-size: 36px;
      line-height: 40px;
      letter-spacing: 0.18px;
    }
  }

  /* Mobile arrows - in header */
  .review-carousel__arrows--mobile {
    position: static;
    display: flex;
    mix-blend-mode: normal;
    pointer-events: auto;
  }

  .review-carousel__arrows--mobile .slideshow-control {
    opacity: 1;
    color: var(--color-foreground);
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .review-carousel__arrows--mobile {
      display: none;
    }
  }

  /* Desktop arrows - on sides of carousel */
  .review-carousel__arrows--desktop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .review-carousel__container {
      position: relative;
    }

    .review-carousel__arrows--desktop {
      display: flex;
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      mix-blend-mode: normal;
      align-items: center;
      justify-content: space-between;
    }

    .review-carousel__arrows--desktop .slideshow-control {
      opacity: 1;
      pointer-events: auto;
      color: var(--color-foreground);
      padding: 0;
    }

    .review-carousel__arrows--desktop .slideshow-control--previous {
      transform: translateX(-40px);
    }

    .review-carousel__arrows--desktop .slideshow-control--next {
      transform: translateX(40px);
    }
  }

  /* Slides container */
  .review-carousel__slides {
    display: flex;
    gap: var(--columns-gap, 16px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .review-carousel__slides::-webkit-scrollbar {
    display: none;
  }

  .review-carousel__slide {
    scroll-snap-align: start;
    flex-shrink: 0;
    min-width: 100%;
  }

  @media screen and (min-width: 750px) {
    .review-carousel__slide {
      min-width: calc((100% - var(--columns-gap, 16px)) / 2);
    }
  }

  /* Review card */
  .review-card {
    display: flex;
    flex-direction: row;
    gap: 0;
  }

  @media screen and (min-width: 750px) {
    .review-card {
      gap: 16px;
    }
  }

  .review-card__image {
    flex-shrink: 0;
    width: 132px;
    height: 189px;
  }

  @media screen and (min-width: 750px) {
    .review-card__image {
      width: 162px;
      height: 232px;
    }
  }

  .review-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .review-card__content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .review-card__content {
      gap: 12px;
    }
  }

  .review-card__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Star rating styles */
  .star-rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .star-rating__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .star-rating__icon {
    display: block;
    flex-shrink: 0;
  }

  .star-rating__count {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    color: #6A6A6A;
  }

  .review-card__product-name {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 12px;
    line-height: 17px;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .review-card__product-name {
      font-size: 18px;
      line-height: 23px;
    }
  }

  .review-card__quote {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .review-card__text {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 21px;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .review-card__text {
      font-size: 20px;
      line-height: 25px;
    }
  }

  .review-card__reviewer {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 19px;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .review-card__reviewer {
      font-size: 18px;
      line-height: 23px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.review_carousel",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "WHAT PEOPLE SAY"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:settings.star_color",
      "default": "#0074E0"
    },
    {
      "type": "color",
      "id": "empty_star_color",
      "label": "t:settings.empty_star_color",
      "default": "#D9D9D9"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:names.review",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "t:settings.product_image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "t:settings.product_name",
          "default": "Product Name"
        },
        {
          "type": "range",
          "id": "star_rating",
          "label": "t:settings.star_rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "t:settings.review_count",
          "default": "40"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "t:settings.review_text",
          "default": "\"This is a great product! I highly recommend it to everyone.\""
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "t:settings.reviewer_name",
          "default": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.review_carousel",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "product_name": "ACE Pullover Hooded Sweatshirt",
            "star_rating": 5,
            "review_count": "40",
            "review_text": "\"This is exactly what was described and what I was looking for...it washed and dried very well. My husband loves it!\"",
            "reviewer_name": "Carol H."
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "product_name": "18-Hour Jersey Trunk",
            "star_rating": 5,
            "review_count": "40",
            "review_text": "\"I love every single piece of clothing I buy from Mack and Weldon, especially the underwear.\"",
            "reviewer_name": "Yanny F."
          }
        }
      },
      "block_order": ["review_1", "review_2"]
    }
  ]
}
{% endschema %}
