<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--full-width color-{{ section.settings.color_scheme }}">
  <div
    class="custom-footer spacing-style"
    style="
      {% render 'spacing-style', settings: section.settings %}
      --top-border-color: {{ section.settings.top_border_color }};
      --top-border-width: {{ section.settings.top_border_width }}px;
    "
  >
    <div class="custom-footer__inner">
      <div class="custom-footer__subscribe">
        {% if section.settings.mobile_logo != blank %}
          <div class="custom-footer__logo">
            {{
              section.settings.mobile_logo
              | image_url: width: section.settings.mobile_logo.width
              | image_tag:
                widths: '49,98,147',
                sizes: '49px',
                loading: 'lazy',
                alt: section.settings.mobile_logo.alt
            }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="custom-footer__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        <form method="post" action="/contact#contact_form" accept-charset="UTF-8" class="custom-footer__form">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="custom-footer__input-group">
            <input
              type="email"
              name="contact[email]"
              class="custom-footer__input"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="custom-footer__submit" aria-label="Subscribe">
              {{ 'icon-arrow-submit.svg' | inline_asset_content }}
            </button>
          </div>
        </form>

        {% if section.settings.show_chat_link %}
          <div class="custom-footer__chat">
            <svg class="custom-footer__chat-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M10 0C4.477 0 0 3.582 0 8c0 2.613 1.532 4.938 3.926 6.462-.218 1.588-1.132 3.015-2.082 3.996a.5.5 0 0 0 .348.842c2.638.04 4.946-.906 6.393-1.886.454.058.92.086 1.415.086 5.523 0 10-3.582 10-8s-4.477-8-10-8z" fill="currentColor"/>
            </svg>
            {% if section.settings.chat_url != blank %}
              <a href="{{ section.settings.chat_url }}" class="custom-footer__chat-link">{{ section.settings.chat_label | escape }}</a>
            {% else %}
              <span class="custom-footer__chat-link">{{ section.settings.chat_label | escape }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="custom-footer__cols">
        <div class="custom-footer__nav-columns">
          {% for block in section.blocks %}
            {% if block.type == 'menu-column' %}
              {% liquid
                assign visibility_class = ''
                if block.settings.visibility == 'desktop_only'
                  assign visibility_class = 'custom-footer__nav-col--desktop-only'
                elsif block.settings.visibility == 'mobile_only'
                  assign visibility_class = 'custom-footer__nav-col--mobile-only'
                endif
              %}
              <div class="custom-footer__nav-col {{ visibility_class }}" {{ block.shopify_attributes }}>
                <div class="custom-footer__nav-desktop">
                  {% if block.settings.heading != blank %}
                    <h3 class="custom-footer__nav-heading">{{ block.settings.heading | escape }}</h3>
                  {% endif %}
                  {% if block.settings.menu != blank %}
                    <ul class="custom-footer__nav-list">
                      {% for link in linklists[block.settings.menu].links %}
                        <li>
                          <a href="{{ link.url }}">{{ link.title | escape }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>

                <details class="custom-footer__nav-mobile">
                  <summary class="custom-footer__accordion-trigger">
                    <span>{{ block.settings.heading | escape }}</span>
                    <svg class="custom-footer__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  {% if block.settings.menu != blank %}
                    <ul class="custom-footer__nav-list custom-footer__nav-list--mobile">
                      {% for link in linklists[block.settings.menu].links %}
                        <li>
                          <a href="{{ link.url }}">{{ link.title | escape }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </details>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="custom-footer__social-review-col">
          <div class="custom-footer__social-icons">
            {% if section.settings.social_instagram != blank %}
              <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="custom-footer__social-link">
                {{ 'instagram.svg' | inline_asset_content }}
              </a>
            {% endif %}
            {% if section.settings.social_facebook != blank %}
              <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="custom-footer__social-link">
                {{ 'facebook.svg' | inline_asset_content }}
              </a>
            {% endif %}
            {% if section.settings.social_twitter != blank %}
              <a href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="custom-footer__social-link">
                {{ 'twitter.svg' | inline_asset_content }}
              </a>
            {% endif %}
            {% if section.settings.social_youtube != blank %}
              <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="custom-footer__social-link">
                {{ 'youtube.svg' | inline_asset_content }}
              </a>
            {% endif %}
            {% if section.settings.social_pinterest != blank %}
              <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest" class="custom-footer__social-link">
                {{ 'pinterest.svg' | inline_asset_content }}
              </a>
            {% endif %}
          </div>

          {% if section.settings.show_google_reviews %}
            <div class="custom-footer__reviews">
              {% if section.settings.google_reviews_url != blank %}
                <a href="{{ section.settings.google_reviews_url }}" target="_blank" rel="noopener noreferrer" class="custom-footer__reviews-link">
              {% endif %}
                <div class="custom-footer__reviews-rating">
                  <span class="custom-footer__reviews-score">{{ section.settings.google_rating | escape }}</span>
                  <div class="custom-footer__reviews-stars">
                    {% for i in (1..5) %}
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M6 1L7.545 4.13L11 4.635L8.5 7.07L9.09 10.51L6 8.885L2.91 10.51L3.5 7.07L1 4.635L4.455 4.13L6 1Z" stroke="#0074E0" stroke-width="0.667" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endfor %}
                  </div>
                </div>
                {% if section.settings.google_review_text != blank %}
                  <span class="custom-footer__reviews-text">{{ section.settings.google_review_text | escape | newline_to_br }}</span>
                {% endif %}
              {% if section.settings.google_reviews_url != blank %}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="custom-footer__bottom">
      {% if section.settings.policy_menu != blank %}
        <div class="custom-footer__policy-links">
          {% for link in linklists[section.settings.policy_menu].links %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.copyright_text != blank %}
        <div class="custom-footer__copyright">
          {{ section.settings.copyright_text | escape }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-footer {
    width: 100%;
    border-top: var(--top-border-width) solid var(--top-border-color);
  }

  .custom-footer__inner {
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: 40px;
  }

  .custom-footer__subscribe {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .custom-footer__logo {
    display: none;
  }

  .custom-footer__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 36px;
    line-height: 40px;
    letter-spacing: 0.18px;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .custom-footer__form {
    width: 100%;
    max-width: 330px;
  }

  .custom-footer__input-group {
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--color-foreground);
  }

  .custom-footer__input {
    background: transparent;
    border: none;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 18px;
    line-height: 22px;
    padding: 12px 0;
    flex: 1;
    min-width: 0;
    outline: none;
  }

  .custom-footer__input::placeholder {
    color: var(--color-foreground);
    opacity: 1;
  }

  .custom-footer__submit {
    background: none;
    border: none;
    cursor: pointer;
    width: 32px;
    height: 32px;
    padding: 0;
    flex-shrink: 0;
    color: var(--color-foreground-heading);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-footer__submit svg {
    width: 32px;
    height: 32px;
    display: block;
  }

  .custom-footer__chat {
    display: none;
  }

  .custom-footer__chat-icon {
    width: 20px;
    height: 20px;
    color: var(--color-foreground-heading);
    flex-shrink: 0;
  }

  .custom-footer__chat-link {
    color: var(--color-foreground-heading);
    text-decoration: underline;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 500;
    line-height: 19px;
  }

  .custom-footer__cols {
    display: flex;
    gap: 40px;
  }

  .custom-footer__nav-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    flex: 1;
  }

  .custom-footer__nav-desktop {
    display: block;
  }

  .custom-footer__nav-mobile {
    display: none;
  }

  .custom-footer__nav-heading {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 18px;
    line-height: 23px;
    color: var(--color-foreground-heading);
    margin: 0 0 16px;
  }

  .custom-footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .custom-footer__nav-list a {
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 19px;
    text-decoration: none;
  }

  .custom-footer__nav-list a:hover {
    text-decoration: underline;
  }

  .custom-footer__social-review-col {
    flex-shrink: 0;
    width: 190px;
  }

  .custom-footer__social-icons {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .custom-footer__social-link {
    color: var(--color-foreground-heading);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-footer__social-link svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .custom-footer__reviews {
    margin-top: 12px;
  }

  .custom-footer__reviews-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .custom-footer__reviews-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .custom-footer__reviews-score {
    font-family: var(--font-body--family);
    font-size: 18px;
    line-height: 23px;
    color: var(--color-foreground-heading);
  }

  .custom-footer__reviews-stars {
    display: flex;
    gap: 2px;
    align-items: center;
  }

  .custom-footer__reviews-text {
    display: block;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 19px;
    color: var(--color-foreground-heading);
    margin-top: 4px;
  }

  .custom-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1360px;
    margin-inline: auto;
    padding-top: 40px;
    padding-inline: 40px;
  }

  .custom-footer__policy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .custom-footer__policy-links a {
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 19px;
    letter-spacing: 0.18px;
    text-decoration: none;
  }

  .custom-footer__policy-links a:hover {
    text-decoration: underline;
  }

  .custom-footer__copyright {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 19px;
    letter-spacing: 0.16px;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-align: end;
    white-space: nowrap;
  }

  .custom-footer__accordion-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding-block: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 19px;
    color: var(--color-foreground-heading);
    cursor: pointer;
    list-style: none;
  }

  .custom-footer__accordion-trigger::-webkit-details-marker {
    display: none;
  }

  .custom-footer__chevron {
    width: 12px;
    height: 8px;
    transition: transform 0.3s ease;
    color: var(--color-foreground-heading);
  }

  details[open] > .custom-footer__accordion-trigger .custom-footer__chevron {
    transform: rotate(180deg);
  }

  .custom-footer__nav-list--mobile {
    padding-block: 12px;
  }

  .custom-footer__nav-col--desktop-only .custom-footer__nav-mobile {
    display: none;
  }

  .custom-footer__nav-col--mobile-only {
    display: none;
  }

  /* Desktop layout */
  @media screen and (min-width: 750px) {
    .custom-footer__inner {
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 80px;
    }

    .custom-footer__nav-col--mobile-only {
      display: none;
    }
  }

  /* Mobile layout */
  @media screen and (max-width: 749px) {
    .custom-footer__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-inline: 16px;
    }

    .custom-footer__logo {
      display: block;
      margin-bottom: 16px;
    }

    .custom-footer__subscribe {
      align-items: center;
      text-align: center;
      width: 100%;
    }

    .custom-footer__heading {
      font-size: 24px;
      line-height: 28px;
      letter-spacing: 0.12px;
      text-align: center;
    }

    .custom-footer__form {
      max-width: 100%;
    }

    .custom-footer__input {
      font-size: 14px;
    }

    .custom-footer__chat {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 24px;
    }

    .custom-footer__nav-desktop {
      display: none;
    }

    .custom-footer__nav-mobile {
      display: block;
    }

    .custom-footer__cols {
      flex-direction: column;
      width: 100%;
      gap: 0;
    }

    .custom-footer__nav-columns {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .custom-footer__nav-col--desktop-only {
      display: none;
    }

    .custom-footer__nav-col--desktop-only .custom-footer__nav-mobile {
      display: none;
    }

    .custom-footer__nav-col--mobile-only {
      display: block;
    }

    .custom-footer__social-review-col {
      width: 100%;
    }

    .custom-footer__social-icons {
      justify-content: center;
      gap: 24px;
      margin-block: 32px;
    }

    .custom-footer__social-link svg {
      width: 40px;
      height: 40px;
    }

    .custom-footer__reviews {
      display: none;
    }

    .custom-footer__bottom {
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding-top: 32px;
      padding-inline: 16px;
    }

    .custom-footer__policy-links {
      justify-content: center;
      gap: 16px;
    }

    .custom-footer__policy-links a {
      font-size: 12px;
      line-height: 17px;
    }

    .custom-footer__copyright {
      font-size: 11px;
      line-height: 13px;
      text-align: center;
      letter-spacing: 0.16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-footer__chevron {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_footer",
  "tag": "footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "blocks": [
    {
      "type": "menu-column",
      "name": "t:names.menu_column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:settings.menu"
        },
        {
          "type": "select",
          "id": "visibility",
          "label": "t:settings.visibility",
          "options": [
            { "value": "both", "label": "t:options.both" },
            { "value": "desktop_only", "label": "t:options.desktop_only" },
            { "value": "mobile_only", "label": "t:options.mobile_only" }
          ],
          "default": "both"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.email_signup"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Sign up for exclusive offers, product news, and loyalty rewards"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:settings.email_placeholder",
      "default": "Your email address..."
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "t:settings.mobile_logo"
    },
    {
      "type": "header",
      "content": "t:content.chat"
    },
    {
      "type": "checkbox",
      "id": "show_chat_link",
      "label": "t:settings.show_chat_link",
      "default": true
    },
    {
      "type": "text",
      "id": "chat_label",
      "label": "t:settings.chat_label",
      "default": "Chat with us"
    },
    {
      "type": "url",
      "id": "chat_url",
      "label": "t:settings.chat_url"
    },
    {
      "type": "header",
      "content": "t:content.social_and_reviews"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "t:settings.social_instagram"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "t:settings.social_facebook"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "t:settings.social_twitter"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "t:settings.social_youtube"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "t:settings.social_pinterest"
    },
    {
      "type": "checkbox",
      "id": "show_google_reviews",
      "label": "t:settings.show_google_reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "google_rating",
      "label": "t:settings.google_rating",
      "default": "4.5"
    },
    {
      "type": "text",
      "id": "google_review_text",
      "label": "t:settings.google_review_text",
      "default": "Google\nCustomer Reviews"
    },
    {
      "type": "url",
      "id": "google_reviews_url",
      "label": "t:settings.google_reviews_url"
    },
    {
      "type": "header",
      "content": "t:content.bottom_bar"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "t:settings.policy_menu"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:settings.copyright_text",
      "default": "© 2024 MACK WELDON. ALL RIGHTS RESERVED."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "top_border_color",
      "label": "t:settings.top_border_color",
      "default": "#0074E0"
    },
    {
      "type": "range",
      "id": "top_border_width",
      "label": "t:settings.top_border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-8"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_footer",
      "category": "Footer",
      "blocks": {
        "col1": {
          "type": "menu-column",
          "settings": {
            "heading": "About Us"
          }
        },
        "col2": {
          "type": "menu-column",
          "settings": {
            "heading": "Support"
          }
        },
        "col3": {
          "type": "menu-column",
          "settings": {
            "heading": "Account"
          }
        },
        "col4": {
          "type": "menu-column",
          "settings": {
            "heading": "Need Help?"
          }
        },
        "col5": {
          "type": "menu-column",
          "settings": {
            "heading": "Shop",
            "visibility": "mobile_only"
          }
        }
      },
      "block_order": ["col1", "col2", "col3", "col4", "col5"]
    }
  ]
}
{% endschema %}
