{% liquid
  assign heading = section.settings.heading | default: 'Recently Viewed'
%}

<recently-viewed-section
  data-section-id="{{ section.id }}"
  style="display: none;"
>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      section--page-width
      color-{{ section.settings.color_scheme }}
      recently-viewed
      spacing-style
    "
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="recently-viewed__header">
      <h2 class="recently-viewed__heading">{{ heading | escape }}</h2>
      <div class="recently-viewed__arrows">
        <button
          ref="prevArrow"
          class="recently-viewed__arrow recently-viewed__arrow--prev recently-viewed__arrow--disabled"
          aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          aria-disabled="true"
          on:click="/handlePrev"
        >
          <span class="recently-viewed__arrow-icon recently-viewed__arrow-icon--prev">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </button>
        <button
          ref="nextArrow"
          class="recently-viewed__arrow recently-viewed__arrow--next"
          aria-label="{{ 'accessibility.slideshow_next' | t }}"
          aria-disabled="false"
          on:click="/handleNext"
        >
          <span class="recently-viewed__arrow-icon recently-viewed__arrow-icon--next">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    </div>

    <div
      ref="carousel"
      class="recently-viewed__carousel"
      on:scroll="/handleScroll"
    >
      {% comment %}
        Product cards are injected client-side via the Section Rendering API.
        On server render (for the Section Rendering API response), we iterate search results:
      {% endcomment %}
      {% if search.performed and search.results_count > 0 %}
        {% for product in search.results %}
          {% if product.object_type == 'product' %}
            <div class="recently-viewed__slide">
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</recently-viewed-section>

<script src="{{ 'recently-viewed-section.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .recently-viewed {
    --carousel-gap-desktop: 16px;
    --carousel-gap-mobile: 12px;
  }

  .recently-viewed__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 16px;
  }

  .recently-viewed__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 500;
    font-size: 32px;
    line-height: 32px;
    letter-spacing: 0.16px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .recently-viewed__arrows {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .recently-viewed__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--color-foreground);
    line-height: 0;
  }

  .recently-viewed__arrow--disabled {
    color: #D9D9D9;
    cursor: default;
    pointer-events: none;
  }

  .recently-viewed__arrow-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recently-viewed__arrow-icon svg {
    width: 13px;
    height: 24px;
  }

  .recently-viewed__arrow-icon--prev {
    rotate: 90deg;
  }

  .recently-viewed__arrow-icon--next {
    rotate: -90deg;
  }

  .recently-viewed__carousel {
    display: flex;
    gap: var(--carousel-gap-desktop);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .recently-viewed__carousel::-webkit-scrollbar {
    display: none;
  }

  .recently-viewed__slide {
    flex: 0 0 calc((100% - 3 * var(--carousel-gap-desktop)) / 4);
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .recently-viewed__heading {
      font-size: 24px;
      line-height: 28px;
      letter-spacing: 0.12px;
    }

    .recently-viewed__arrows {
      gap: 10px;
    }

    .recently-viewed__arrow-icon svg {
      width: 10px;
      height: 16px;
    }

    .recently-viewed__carousel {
      gap: var(--carousel-gap-mobile);
      padding-inline: 16px;
      margin-inline: -16px;
    }

    .recently-viewed__slide {
      flex: 0 0 calc((100% - var(--carousel-gap-mobile)) / 2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.recently_viewed",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Recently Viewed"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.recently_viewed"
    }
  ]
}
{% endschema %}
