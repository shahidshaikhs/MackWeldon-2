<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  {% assign subcategory_links = section.blocks | where: 'type', '_subcategory-link' %}
  {% if subcategory_links.size > 0 %}
    <nav class="collection-subcategory-links" aria-label="Subcategory navigation">
      {% content_for 'blocks' %}
    </nav>
  {% endif %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% stylesheet %}
  .main-collection-grid {
    grid-column: var(--grid-column--mobile);

    @media screen and (min-width: 750px) {
      grid-column: var(--grid-column--desktop);
    }
  }

  .collection-subcategory-links {
    grid-column: var(--full-width);
    display: flex;
    gap: 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-inline: var(--page-margin);
    padding-block: 0 8px;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      grid-column: var(--centered);
      gap: 24px;
      overflow-x: visible;
      flex-wrap: wrap;
      padding-inline: 0;
      padding-block: 0 12px;
    }
  }

  /* Collection product card gap overrides — Figma: 0px image-to-title, 4px between content items */
  .product-grid product-card .product-card__content.product-grid__card {
    gap: 0;
  }

  .product-grid product-card .product-card__content.product-grid__card > *:not(:first-child) {
    margin-top: 4px;
  }

  .product-grid product-card .product-card__content.product-grid__card > *:nth-child(2) {
    margin-top: 0;
  }

  @media screen and (max-width: 749px) {
    .product-grid product-card .product-card__content.product-grid__card > *:nth-child(2) {
      margin-top: 4px;
    }

    .product-grid product-card .product-card__content.product-grid__card > *:not(:first-child):not(:nth-child(2)) {
      margin-top: 2px;
    }
  }

  /* Collection product card typography overrides */
  /* Product title */
  .product-grid product-card product-title .text-block {
    font-size: 16px;
    line-height: 27px;
    font-weight: 400;
  }

  @media screen and (max-width: 749px) {
    .product-grid product-card product-title .text-block {
      font-size: 14px;
      line-height: 19px;
    }
  }

  /* Product price */
  .product-grid product-card product-price.text-block {
    font-size: 18px;
    line-height: 23px;
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .product-grid product-card product-price.text-block {
      font-size: 14px;
      line-height: 19px;
    }
  }

  /* Review/count text */
  .product-grid product-card .star-rating {
    font-size: 12px;
    line-height: 16px;
  }

  .product-grid product-card .star-rating__count {
    color: #6A6A6A;
    font-size: 12px;
    line-height: 16px;
  }

  /* Variant count / colors available text */
  .product-grid product-card .product-card__content .variant-option__label,
  .product-grid product-card .product-card__content .product-card-swatches__count {
    font-size: 12px;
    line-height: 16px;
    text-transform: capitalize;
  }

  /* Load More button styling */
  .product-grid-container .pagination-controls .button,
  .product-grid-container [ref="viewMoreNext"] + .button,
  .product-grid-container .load-more-button {
    background-color: var(--color-foreground);
    color: var(--color-background);
    text-transform: uppercase;
    font-weight: 500;
    font-size: 14px;
    line-height: 19px;
    min-height: 45px;
    width: 100%;
    max-width: 318px;
    margin-inline: auto;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .product-grid-container .pagination-controls .button,
    .product-grid-container [ref="viewMoreNext"] + .button,
    .product-grid-container .load-more-button {
      max-width: 343px;
    }
  }

  /* Badge overlay styling for product card images */
  .product-grid product-card .product-card__badge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    background: #FFFFFF;
    color: #0074E0;
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    padding: 6px 8px;
    line-height: 16px;
  }

  @media screen and (max-width: 749px) {
    .product-grid product-card .product-card__badge {
      font-size: 12px;
      padding: 2px 4px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "_subcategory-link"
    }
  ],
  "presets": []
}
{% endschema %}
