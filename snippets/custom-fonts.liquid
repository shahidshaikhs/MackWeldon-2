<style>
  /* Custom font loading for Mack Weldon brand fonts */
  /* National 2 Condensed — Headings (weight 500) */
  @font-face {
    font-family: 'National 2 Condensed';
    font-weight: 500;
    font-style: normal;
    font-display: swap;
    src: url({{ 'national-2-condensed-medium.woff2' | asset_url }}) format('woff2');
  }

  /* Untitled Sans — Body (weight 400) */
  @font-face {
    font-family: 'Untitled Sans';
    font-weight: 400;
    font-style: normal;
    font-display: swap;
    src: url({{ 'untitled-sans-regular.woff2' | asset_url }}) format('woff2');
  }

  /* Untitled Sans — Body Medium (weight 500) */
  @font-face {
    font-family: 'Untitled Sans';
    font-weight: 500;
    font-style: normal;
    font-display: swap;
    src: url({{ 'untitled-sans-medium.woff2' | asset_url }}) format('woff2');
  }

  :root {
    --font-heading--family: 'National 2 Condensed', var(--font-heading--family-fallback, sans-serif);
    --font-heading--weight: 500;
    --font-heading--style: normal;
    --font-body--family: 'Untitled Sans', var(--font-body--family-fallback, sans-serif);
    --font-body--weight: 400;
    --font-body--style: normal;
    --font-subheading--family: 'Untitled Sans', var(--font-subheading--family-fallback, sans-serif);
    --font-subheading--weight: 500;
