{
  "sections": {
    "product-information": {
      "type": "product-information",
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "gap": 16,
        "enable_sticky_add_to_cart": true,
        "color_scheme": "scheme-1",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid"
          }
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "gap": 12,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "inherit_color_scheme": true,
            "border": "none"
          },
          "blocks": {
            "review_stars": {
              "type": "review",
              "settings": {
                "stars_style": "shaded",
                "show_number": true,
                "rating_color": "primary",
                "type_preset": "paragraph",
                "width": "fit-content",
                "alignment": "left"
              }
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "h2",
                "color": "var(--color-foreground)",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_tax_info": false,
                "type_preset": "h4",
                "width": "100%",
                "alignment": "left"
              }
            },
            "description": {
              "type": "product-description",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "variant_picker": {
              "type": "variant-picker",
              "settings": {
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "subscription_picker": {
              "type": "subscription-picker",
              "settings": {
                "one_time_label": "One Time Purchase",
                "subscribe_label": "Subscribe & Save"
              }
            },
            "buy_buttons": {
              "type": "buy-buttons",
              "settings": {
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button-secondary"
                  }
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true
                }
              },
              "block_order": []
            },
            "shipping_info": {
              "type": "text",
              "settings": {
                "text": "<p><strong>Free Shipping</strong> on orders over $75  |  <strong>Free returns</strong></p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "paragraph",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "rewards_info": {
              "type": "text",
              "settings": {
                "text": "<p>Earn 124 points with this purchase.</p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "paragraph",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "bottom_links": {
              "type": "pdp-bottom-links",
              "settings": {}
            }
          },
          "block_order": [
            "review_stars",
            "product_title",
            "price",
            "description",
            "variant_picker",
            "subscription_picker",
            "buy_buttons",
            "shipping_info",
            "rewards_info",
            "bottom_links"
          ]
        }
      }
    },
    "every-detail-matters": {
      "type": "media-with-content",
      "settings": {
        "media_position": "left",
        "media_width": "medium",
        "media_height": "auto",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "media_type": "image",
            "image": "shopify://shop_images/bitmap-desktop-banner-1075087.png",
            "image_position": "cover"
          }
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "flex-start",
            "gap": 24
          },
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h2>Every Detail Matters</h2>",
                "type_preset": "h2",
                "width": "100%",
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 16,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "feature_1": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "gap": 16,
                "width": "fill",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
                "inherit_color_scheme": true,
                "border": "none"
              },
              "blocks": {
                "icon_1": {
                  "type": "image",
                  "settings": {
                    "image": "shopify://shop_images/bitmap-desktop-banner-1075120.png",
                    "image_ratio": "square",
                    "width": "fit-content"
                  }
                },
                "text_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Supportive flyless pouch</p>",
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  }
                }
              },
              "block_order": ["icon_1", "text_1"]
            },
            "feature_2": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "gap": 16,
                "width": "fill",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
