                "text_2": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Moisture-wicking & odor-fighting</p>",
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  }
                }
              },
              "block_order": ["icon_2", "text_2"]
            },
            "feature_3": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "gap": 16,
                "width": "fill",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
                "inherit_color_scheme": true,
                "border": "none"
              },
              "blocks": {
                "icon_3": {
                  "type": "image",
                  "settings": {
                    "image": "shopify://shop_images/bitmap-desktop-banner-1075112.png",
                    "image_ratio": "square",
                    "width": "fit-content"
                  }
                },
                "text_3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Targeted cool zones</p>",
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  }
                }
              },
              "block_order": ["icon_3", "text_3"]
            },
            "feature_4": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "gap": 16,
                "width": "fill",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
                "inherit_color_scheme": true,
                "border": "none"
              },
              "blocks": {
                "icon_4": {
                  "type": "image",
                  "settings": {
                    "image": "shopify://shop_images/bitmap-desktop-banner-1075109.png",
                    "image_ratio": "square",
                    "width": "fit-content"
                  }
                },
                "text_4": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No-roll waistband</p>",
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  }
                }
              },
              "block_order": ["icon_4", "text_4"]
            },
            "feature_5": {
              "type": "group",
              "settings": {
                "content_direction": "row",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "gap": 16,
                "width": "fill",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0,
                "inherit_color_scheme": true,
                "border": "none"
              },
              "blocks": {
                "icon_5": {
                  "type": "image",
                  "settings": {
                    "image": "shopify://shop_images/bitmap-desktop-banner-1075106.png",
                    "image_ratio": "square",
                    "width": "fit-content"
                  }
                },
                "text_5": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Stay-put legs</p>",
                    "type_preset": "paragraph",
