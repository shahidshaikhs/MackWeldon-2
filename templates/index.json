{
  "sections": {
    "review_carousel": {
      "type": "review-carousel",
      "settings": {
        "heading": "WHAT PEOPLE SAY",
        "color_scheme": "scheme-1",
        "star_color": "#0074E0",
        "empty_star_color": "#D9D9D9",
        "columns_gap": 16,
        "section_width": "page-width",
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "product_image": "shopify:\/\/shop_images\/rectangle-545-mobile-hero-I396827411619.png",
            "product_name": "ACE Pullover Hooded Sweatshirt",
            "star_rating": 5,
            "review_count": "40",
            "review_text": "\"This is exactly what was described and what I was looking for...it washed and dried very well. My husband loves it!\"",
            "reviewer_name": "Carol H."
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "product_image": "shopify:\/\/shop_images\/rectangle-545-desktop-hero-I39602677471.png",
            "product_name": "18-Hour Jersey Trunk",
            "star_rating": 5,
            "review_count": "40",
            "review_text": "\"I love every single piece of clothing I buy from Mack and Weldon, especially the underwear.\"",
            "reviewer_name": "Yanny F."
          }
        }
      },
      "block_order": [
        "review_1",
        "review_2"
      ]
    },
    "blog_posts": {
      "type": "featured-blog-posts",
      "settings": {
        "layout_type": "grid",
        "carousel_on_mobile": true,
        "post_limit": 3,
        "columns": 3,
        "mobile_card_size": "60cqw",
        "columns_gap": 32,
        "icons_style": "none",
        "section_width": "page-width",
        "gap": 12,
        "color_scheme": "scheme-1",
        "padding-block-start": 20,
        "padding-block-end": 20
      },
      "blocks": {
        "static-blog-title": {
          "type": "_featured-blog-posts-title",
          "static": true,
          "settings": {
            "text": "<h3>MACK WELDON BLOG<\/h3><p><a href=\"\/blogs\/blog\" title=\"View All Articles\">View All Articles<\/a><\/p>",
            "type_preset": "rte"
          }
        },
        "static-blog-post-card": {
          "type": "_featured-blog-posts-card",
          "static": true,
          "settings": {
            "alignment": "left",
            "gap": 12
          },
          "blocks": {
            "image": {
              "type": "_featured-blog-posts-image",
              "static": true,
              "settings": {
                "image_ratio": "landscape"
              }
            },
            "title": {
              "type": "_heading",
              "static": true,
              "settings": {
                "type_preset": "rte",
                "show_alignment": false
              }
            },
            "blog-post-info-text": {
              "type": "_blog-post-info-text",
              "static": true,
              "settings": {
                "padding-block-start": 0,
                "padding-block-end": 0
              }
            },
            "blog-post-description": {
              "type": "_blog-post-description",
              "static": true,
              "settings": {
                "padding-block-start": 0,
                "padding-block-end": 0
              }
            }
          }
        }
      }
    },
    "ugc-carousel": {
      "type": "carousel",
      "settings": {
        "columns": 5,
        "mobile_columns": "2",
        "section_width": "page-width",
